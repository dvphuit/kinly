rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /googleAccounts/{uid} {
      allow read, write: if false;
    }

    match /oauthTransactions/{transactionId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
