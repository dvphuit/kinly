# Google OAuth client ID is public, but the client secret must stay in Firebase Secret Manager.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Firebase Web SDK config (public application configuration).
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=baby-growth-dvphu.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=baby-growth-dvphu
VITE_FIREBASE_STORAGE_BUCKET=baby-growth-dvphu.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id

# Enable the Firebase Functions OAuth/Drive proxy in the SPA.
VITE_GOOGLE_DRIVE_BACKEND=firebase

# Function parameters are configured with Firebase CLI / Secret Manager, not VITE_*.
# GOOGLE_CLIENT_ID=598629342498-c8ltki5l6hfn395ts1497hu5euks33kv.apps.googleusercontent.com
# GOOGLE_REDIRECT_URI=https://baby-growth-dvphu.web.app/api/google/oauth/callback
# FRONTEND_ORIGIN=https://baby-growth-dvphu.web.app
