# Google OAuth 2.0 Web Client ID
# Create this in Google Cloud Console and add your deployed origin to Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional Cloudflare Worker OAuth broker origin.
# When omitted, Kinly keeps the browser GIS + Passkey reauthentication fallback.
VITE_GOOGLE_AUTH_WORKER_URL=
